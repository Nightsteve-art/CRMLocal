# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///eko_production.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# File Uploads
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=static/uploads

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=-your-warehouse-chat-id
TELEGRAM_SEWING_CHAT_ID=-your-sewing-chat-id
TELEGRAM_ZAKAZ_CHAT_ID=-your-orders-chat-id

# Email Configuration (for future email integration)
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.ru
MAIL_PASSWORD=your-email-password

# Session Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Application Settings
ITEMS_PER_PAGE=10
LOG_LEVEL=INFO
