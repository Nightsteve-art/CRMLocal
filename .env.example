# Eko-Production CRM
# Copy this file to .env or set variables in the operating system.

# Required for production: generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret

# Local default is sqlite:///eko_production.db
# DATABASE_URL=postgresql://crm_user:password@localhost:5432/eko_crm

UPLOAD_FOLDER=static/uploads
ITEMS_PER_PAGE=10

# Optional Telegram notifications. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEWING_CHAT_ID=
TELEGRAM_ZAKAZ_CHAT_ID=
